# Never use these example values on a reachable host.
POSTGRES_DB=open_agent
POSTGRES_USER=open_agent
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=open_agent
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=open-agent
CREDENTIAL_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
AUTH_ORIGIN=https://localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443
# Docker Desktop: use absolute paths that Docker file sharing permits.
# TENANTS_ROOT=/absolute/path/open-agent/tenants
