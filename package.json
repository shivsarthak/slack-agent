{
  "name": "open-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An AI coworker that lives in our Slack workspace",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "format:check": "prettier --check package.json dashboard/package.json scripts/verify-compose.mjs tests/verify.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:migrations": "vitest run --passWithNoTests 'tests/migrations/**/*.test.ts'",
    "test:isolation": "vitest run tests/workspace-lifecycle.test.ts tests/vault.test.ts tests/sessions-store.test.ts",
    "test:encryption": "vitest run --passWithNoTests 'tests/encryption/**/*.test.ts'",
    "test:queue": "vitest run tests/queue.test.ts",
    "test:container-policy": "vitest run --passWithNoTests 'tests/container-policy/**/*.test.ts'",
    "compose:check": "node scripts/verify-compose.mjs",
    "test:smoke": "vitest run tests/coworker.test.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/codex": "0.145.0",
    "@slack/bolt": "^5.0.0",
    "date-fns": "4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "execa": "9.6.0",
    "prettier": "3.6.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
